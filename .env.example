# ====================================================================
# Weather Forecast & Alert Application - Environment Configuration
# ====================================================================
# INSTRUCTIONS:
# 1. Copy this file and rename it to ".env" (do NOT commit .env to GitHub)
# 2. Add your personal OpenWeatherMap API key below (get free at https://openweathermap.org/api)
# 3. Note: The application also supports Open-Meteo (zero API key required) and Virtual Simulation!

# OpenWeatherMap API Key (Get free key from https://home.openweathermap.org/api_keys)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Default City for CLI Quick Run
DEFAULT_CITY=London

# Temperature Unit: metric (Celsius) or imperial (Fahrenheit)
WEATHER_UNITS=metric

# Weather Alert Thresholds
ALERT_TEMP_HIGH=35.0      # Trigger alert if temp >= 35°C (95°F)
ALERT_TEMP_LOW=0.0        # Trigger alert if temp <= 0°C (32°F)
ALERT_HUMIDITY_HIGH=85.0  # Trigger alert if humidity >= 85%
ALERT_WIND_SPEED=40.0     # Trigger alert if wind speed >= 40 km/h (strong gale)
ALERT_RAIN_DETECTED=true   # Trigger alert if rain or thunderstorm is detected
